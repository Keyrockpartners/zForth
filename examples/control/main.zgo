// Control flow: FizzBuzz with for, if and switch, plus break, continue,
// labels, fallthrough and every form of for loop.
package main

import "dev"

func fizzbuzz(n int) {
	for i := 1; i <= n; i++ {
		switch {
		case i%15 == 0:
			dev.Printf("FizzBuzz")
		case i%3 == 0:
			dev.Printf("Fizz")
		case i%5 == 0:
			dev.Printf("Buzz")
		default:
			dev.Printf("%d", i)
		}
		if i < n {
			dev.Printf(" ")
		}
	}
	dev.Printf("\n")
}

func classify(c byte) string {
	switch c {
	case 'a', 'e', 'i', 'o', 'u':
		return "vowel"
	case ' ':
		return "space"
	}
	if c >= '0' && c <= '9' {
		return "digit"
	}
	return "other"
}

func grade(score int) string {
	switch s := score / 10; s {
	case 10, 9:
		return "A"
	case 8:
		return "B"
	case 7:
		return "C"
	default:
		return "F"
	}
}

func loops() {
	// condition-only and infinite loops
	n := 0
	for n < 5 {
		n += 2
	}
	k := 0
	for {
		k++
		if k == 3 {
			continue
		}
		if k > 6 {
			break
		}
	}
	dev.Printf("n=%d k=%d\n", n, k)

	// range over an integer (Go 1.22); changing i does not change the count
	sum := 0
	for i := range 10 {
		sum += i
		i += 100
	}
	dev.Printf("sum 0..9 = %d\n", sum)

	// labeled break and continue
	found := 0
outer:
	for i := 0; i < 10; i++ {
		for j := 0; j < 10; j++ {
			if j > i {
				continue outer
			}
			if i*j == 42 {
				found = i*10 + j
				break outer
			}
		}
	}
	dev.Printf("found %d\n", found)

	// break inside switch leaves the switch, not the loop
	count := 0
	for i := 0; i < 5; i++ {
		switch i {
		case 2:
			break
		default:
			count++
		}
	}
	dev.Printf("count %d\n", count)
}

func fall(x int) {
	switch x {
	case 0:
		dev.Printf("zero ")
		fallthrough
	case 1:
		dev.Printf("small ")
	case 2:
		dev.Printf("two ")
		fallthrough
	default:
		dev.Printf("any")
	}
	dev.Printf("\n")
}

func main() {
	fizzbuzz(15)
	for _, c := range []byte{'a', 'x', '7', ' '} {
		dev.Printf("%c:%s ", c, classify(c))
	}
	dev.Printf("\n%s %s %s %s\n", grade(95), grade(100), grade(81), grade(42))
	loops()
	fall(0)
	fall(1)
	fall(2)
	fall(9)
}
