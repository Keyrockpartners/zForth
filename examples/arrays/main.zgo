// Package-level arrays, slices of them, range, copy, a 2D array and a
// moving-average ring buffer.
package main

import "dev"

const window = 4

// ring buffer for a moving average
var (
	samples [window]float32
	next    int
	filled  int
)

func addSample(v float32) float32 {
	samples[next] = v
	next = (next + 1) % window
	if filled < window {
		filled++
	}
	var sum float32
	for _, s := range samples[:filled] {
		sum += s
	}
	return sum / float32(filled)
}

var primes = [...]uint16{2, 3, 5, 7, 11, 13, 17, 19}

func sum(xs []uint16) (total uint32) {
	for _, x := range xs {
		total += uint32(x)
	}
	return
}

func reverse(xs []int32) {
	for i, j := 0, len(xs)-1; i < j; i, j = i+1, j-1 {
		xs[i], xs[j] = xs[j], xs[i]
	}
}

var grid [3][4]int8
var nums = [6]int32{1, 2, 3, 4, 5, 6}
var flags [5]bool
var big [3]int64
var lookup = []string{"zero", "one", "two"}

func main() {
	for _, v := range []float32{10, 20, 30, 40, 50, 60} {
		dev.Printf("%.1f ", addSample(v))
	}
	dev.Printf("\n")

	dev.Printf("len %d, sum %d, first four %d, from 5 %d\n", len(primes), sum(primes[:]), sum(primes[:4]), sum(primes[5:]))

	reverse(nums[:])
	reverse(nums[1:3])
	for i, n := range nums {
		dev.Printf("%d:%d ", i, n)
	}
	dev.Printf("\n")

	for r := range 3 {
		for c := range 4 {
			grid[r][c] = int8(r*10 + c)
		}
	}
	grid[2][3] = -1
	dev.Printf("grid[1][2]=%d grid[2][3]=%d row 2 sum=%d\n", grid[1][2], grid[2][3], int(grid[2][0])+int(grid[2][1])+int(grid[2][2])+int(grid[2][3]))

	var dst [4]int32
	n := copy(dst[:], nums[2:])
	dev.Printf("copied %d: %d %d %d %d\n", n, dst[0], dst[1], dst[2], dst[3])
	n = copy(nums[1:], nums[:])
	dev.Printf("overlapping copy %d: %d %d %d\n", n, nums[0], nums[1], nums[5])

	flags[3] = true
	big[1] = -1 << 40
	big[2] = big[1] * 3
	dev.Printf("flags %v %v, big %d %d, %s\n", flags[0], flags[3], big[1], big[2], lookup[2])

	s := nums[:]
	s = s[2:4]
	dev.Printf("len(s)=%d s[1]=%d s==nil %v\n", len(s), s[1], s == nil)
	var empty []int32
	dev.Printf("empty: len %d, nil %v\n", len(empty), empty == nil)
}
