package main

import "dev"

func ack(m, n int32) int32 {
	if m == 0 {
		return n + 1
	}
	if n == 0 {
		return ack(m-1, 1)
	}
	return ack(m-1, ack(m, n-1))
}

var moves int32

func hanoi(n int32, from, to, via uint8) {
	if n == 0 {
		return
	}
	hanoi(n-1, from, via, to)
	moves++
	hanoi(n-1, via, to, from)
}

func a(n int32) int32 {
	if n <= 0 {
		return 0
	}
	return 1 + b(n-1)
}

func b(n int32) int32 {
	if n <= 0 {
		return 0
	}
	return 2 + c(n-1)
}

func c(n int32) int32 {
	if n <= 0 {
		return 0
	}
	return 3 + a(n-1)
}

func power(x float64, n uint32) float64 {
	if n == 0 {
		return 1
	}
	h := power(x, n/2)
	if n%2 == 0 {
		return h * h
	}
	return h * h * x
}

func sumDigits(n uint64) uint64 {
	if n < 10 {
		return n
	}
	return n%10 + sumDigits(n/10)
}

func main() {
	dev.Printf("ack(2,3)=%d\n", ack(2, 3))
	hanoi(6, 1, 3, 2)
	dev.Printf("hanoi moves %d\n", moves)
	dev.Printf("abc %d %d %d\n", a(10), b(7), c(5))
	dev.Printf("power %.4f %.1f\n", power(1.5, 10), power(2, 40))
	dev.Printf("digits %d\n", sumDigits(18446744073709551615))
}
