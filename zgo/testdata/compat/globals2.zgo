package main

import "dev"

var (
	a = b + 1
	b = f()
	c [4]int32
	d = c[1:3]
	e = &c[2]
	s = "start"
	t = [...]string{"x", "y"}
	u = []uint8{9, 8, 7}
	v = struct2{N: 3, S: "s2"}
)

type struct2 struct {
	N int32
	S string
}

var order int32

func f() int32 {
	order++
	dev.Printf("f called (order %d)\n", order)
	return 41
}

func init() {
	dev.Printf("init 1: a=%d b=%d s=%s\n", a, b, s)
	c[2] = 5
}

func init() {
	dev.Printf("init 2: d=%d %d, *e=%d, len(u)=%d u[2]=%d\n", d[0], d[1], *e, len(u), u[2])
	*e = 6
	u[0]++
}

func main() {
	dev.Printf("main: c[2]=%d u[0]=%d t=%s%s v=%d,%s\n", c[2], u[0], t[0], t[1], v.N, v.S)
}
