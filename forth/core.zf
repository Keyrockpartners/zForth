
( system calls )

: emit    0 sys ;
: .       1 sys ;
: tell    2 sys ;
: quit    128 sys ;
: sin     129 sys ;
: include 130 sys ;
: save    131 sys ;


( dictionary access for regular variable-length cells. These are shortcuts
  through the primitive operations are !!, @@ and ,, ; @ and !, which are
  0 @@ and 0 !!, are primitives )

: ,    0 ,, ;
: #    0 ## ;

( Compiled code is 16-bit units at even addresses: compile, compiles a
  call to an execution token, or a primitive. A jump's operand is a 16-bit
  offset, written with ,j and patched with !j; @j reads its target back.
  addr 0 is an unpatched jump. `64` is the size code for jump operands, see
  zforth.c. calign pads here to an even address, where code goes on after
  bytes compiled into a definition. )

: !j	 64 !! ;
: ,j	 64 ,, ;
: @j	 64 @@ ;

( compiler state )

: [ 0 compiling ! ; immediate
: ] 1 compiling ! ;
: postpone 1 _postpone ! ; immediate


( some operators and shortcuts; 1+ over > != are primitives )
: 1- 1 - ;
: +!   dup @ rot + swap ! ;
: inc  1 swap +! ;
: dec  -1 swap +! ;
: <=   over over >r >r < r> r> = + ;
: >=   swap <= ;
: =0   0 = ;
: not  =0 ;
: cr   10 emit ;
: br 32 emit ;
: ..   dup . ;
: here h @ ;


( memory management )

: allot  h +!  ;
: const >r : r> postpone literal postpone ; ;
: constant >r : r> postpone literal postpone ; ;

( Variable storage comes from data-here/data-allot: inline in the dictionary
  normally, or in the RAM data window when exporting a prebuilt ROM image.
  Always reserve var-max-size so storing a larger value later can't overwrite
  whatever follows. )

: var  data-here var-max-size data-allot 0 over ! constant ;
: variable >r data-here var-max-size data-allot r> over ! constant ;

( 'begin' gets the current address, a jump or conditional jump back is generated
  by 'again', 'until' )

: begin   here ; immediate
: again   ' jmp compile, ,j ; immediate
: until   ' jmp0 compile, ,j ; immediate


( '{ ... ... ... n x}' repeat n times definition - eg. : 5hello { ." hello " 5 x} ; )

: { ( -- ) 0 postpone literal ' >r compile, here ; immediate
: x} ( -- ) ' r> compile, ' 1+ compile, ' dup compile, ' >r compile, ' = compile,
  postpone until ' r> compile, ' drop compile, ; immediate


( vectored execution - execute XT eg. ' hello exe. The return address is
  a 32-bit lit, patched with !! size 1 once known. )

: exe ( XT -- ) ' lit compile, here 0 1 ,, ' >r compile, ' >r compile, ' exit compile,
  here swap 1 !! ; immediate

( execute XT n times  e.g. ' hello 3 times )
: times ( XT n -- ) { >r dup >r exe r> r> dup x} drop drop ;


( 'if' prepares conditional jump, the target address '0' will later be
  overwritten by the 'else' or 'fi' words, with !j )

: if      ' jmp0 compile, here 0 ,j ; immediate
: unless  ' not compile, postpone if ; immediate
: else    ' jmp compile, here 0 ,j swap here swap !j ; immediate
: fi      here swap !j ; immediate


( forth style 'do' and 'loop', including loop iterators 'i' and 'j' )

: i 0 postpone literal ' pickr compile, ; immediate
: j 2 postpone literal ' pickr compile, ; immediate
: do ' swap compile, ' >r compile, ' >r compile, here ; immediate
: loop+ ' r> compile, ' + compile, ' dup compile, ' >r compile, 1 postpone literal
  ' pickr compile, ' >= compile, ' jmp0 compile, ,j ' r> compile, ' drop compile,
  ' r> compile, ' drop compile, ; immediate
: loop 1 postpone literal postpone loop+ ;  immediate


: calign here 1 & if 0 2 ,, fi ;

( Create string literal, puts length and address on the stack. Bytes are
  stored raw, 2 ,, being ,u8, so UTF-8 survives; compiled, lits takes a
  16-bit length, 3 ,, patched with 3 !! once known, and the bytes padded
  to an even length. )

: s" compiling @ if ' lits compile, here 0 3 ,, fi here begin key dup 34 = if drop
     compiling @ if here swap - swap 3 !! calign else dup here swap - fi exit else 2 ,, fi
     again ; immediate

( Print string literal )

: ." compiling @ if postpone s" ' tell compile, else begin key dup 34 = if drop exit else emit fi again
     fi ; immediate


(
vi: ts=3 sw=3 ft=forth
)

